{{/*
  .github/security/gitleaks-report.tmpl
  Template Go (text/template + sprig) para relatorio HTML do Gitleaks.
  Uso:
    gitleaks dir . --report-format=template \
      --report-template=.github/security/gitleaks-report.tmpl \
      --report-path=reports/gitleaks-report.html --redact
  Referencia: https://github.com/gitleaks/gitleaks (secao "Report Templates")
*/}}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Gitleaks - Relatorio de Segredos</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; background:#f6f8fa; color:#1f2328; }
  header { background:#0d1117; color:#fff; padding:24px 32px; }
  header h1 { margin:0; font-size:20px; }
  header p { margin:4px 0 0; color:#8b949e; font-size:13px; }
  .wrap { padding: 24px 32px; }
  .cards { display:flex; gap:12px; margin-bottom:24px; }
  .card { background:#fff; border:1px solid #d0d7de; border-radius:6px; padding:16px 20px; min-width:120px; }
  .card .n { font-size:28px; font-weight:700; }
  .card .l { font-size:12px; text-transform:uppercase; color:#656d76; letter-spacing:.5px; }
  .crit { color:#cf222e; }
  table { width:100%; border-collapse:collapse; background:#fff; border:1px solid #d0d7de; border-radius:6px; overflow:hidden; }
  th { background:#f6f8fa; text-align:left; font-size:12px; text-transform:uppercase; color:#656d76; padding:10px 12px; border-bottom:1px solid #d0d7de; }
  td { padding:10px 12px; border-bottom:1px solid #eaeef2; font-size:13px; vertical-align:top; }
  code { background:#f6f8fa; padding:1px 5px; border-radius:4px; font-size:12px; }
  .badge { display:inline-block; padding:2px 8px; border-radius:12px; font-size:11px; font-weight:700; color:#fff; background:#cf222e; }
  .ok { background:#fff; border:1px solid #d0d7de; border-radius:6px; padding:32px; text-align:center; color:#1a7f37; }
</style>
</head>
<body>
<header>
  <h1>Gitleaks &mdash; Relatorio de Deteccao de Segredos</h1>
  <p>SCA / Secret Scanning &middot; Total de achados: {{ len . }}</p>
</header>
<div class="wrap">

{{ if eq (len .) 0 }}
  <div class="ok"><strong>Nenhum segredo detectado.</strong><br>O repositorio passou na verificacao.</div>
{{ else }}
  <div class="cards">
    <div class="card"><div class="n crit">{{ len . }}</div><div class="l">Critical</div></div>
    <div class="card"><div class="n">{{ len (. | uniq) }}</div><div class="l">Ocorrencias</div></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Risco</th><th>Regra</th><th>Descricao</th><th>Arquivo</th>
        <th>Linha</th><th>Commit</th><th>Autor</th><th>Fingerprint</th>
      </tr>
    </thead>
    <tbody>
    {{ range . }}
      <tr>
        <td><span class="badge">CRITICAL</span></td>
        <td><code>{{ .RuleID }}</code></td>
        <td>{{ .Description }}</td>
        <td><code>{{ .File }}</code></td>
        <td>{{ .StartLine }}</td>
        <td><code>{{ if .Commit }}{{ substr 0 8 .Commit }}{{ else }}worktree{{ end }}</code></td>
        <td>{{ .Author }}{{ if .Email }} &lt;{{ .Email }}&gt;{{ end }}</td>
        <td><code>{{ .Fingerprint }}</code></td>
      </tr>
    {{ end }}
    </tbody>
  </table>

  <p style="font-size:12px;color:#656d76;margin-top:16px;">
    Todo segredo exposto e classificado como <strong>CRITICAL</strong>: o Gitleaks nao emite CVSS,
    a criticidade decorre do proprio vazamento de credencial. Valores exibidos estao redigidos (<code>--redact</code>).
  </p>
{{ end }}

</div>
</body>
</html>
