# ==========================================
# Variáveis de Ambiente do Frontend (Vite)
# ==========================================
# Este arquivo serve como template. Para executar o projeto localmente
# fora do Docker (via `npm run dev`), copie e renomeie este arquivo
# para `.env` e confirme se a porta corresponde à porta que a API está rodando.

# URL base da API do backend
VITE_API_URL=http://localhost:3001/api
