# ==========================================
# Variáveis de Ambiente do Backend
# ==========================================
# Este arquivo é o template. Para rodar o servidor localmente (sem Docker),
# copie este arquivo e o renomeie para `.env`, ajustando os valores de conexão.

# Porta onde a API rodará (quando executada via `npm run dev`)
PORT=3001

# ==========================================
# Configurações do Banco de Dados
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bayarea
DB_USER=prontuario_app
DB_PASSWORD=senha_segura_aqui

# Conexão segura para produção (SSL)
DB_SSL=false

# ==========================================
# Segurança e Autenticação
# ==========================================
# Chave usada para assinar os tokens de acesso gerados no login. 
JWT_SECRET=super_secret_jwt_key_aqui

# ==========================================
# Configurações de E-mail (Recuperação de senha)
# ==========================================
# Preencha com os dados do seu provedor SMTP (ex: Gmail, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_ou_smtp
SMTP_FROM=seu_email@gmail.com

# ==========================================
# Configurações do Sistema
# ==========================================
# URL pública do Frontend (usada para gerar links enviados por e-mail)
FRONTEND_URL=http://localhost
