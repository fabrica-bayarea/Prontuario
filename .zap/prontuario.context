<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
    Context do ZAP para o ambiente de dev do Prontuario.

    Escopo:
      - Limita o spider e o scanner ao path /prontuario-dev/
      - Aceita variações de case e com/sem trailing slash
      - Como inscope=true e só temos incregexes, qualquer URL fora
        do path automaticamente NÃO entra no escopo (não precisa
        de excregexes explícito, que estava causando URL_NOT_IN_CONTEXT)
-->
<configuration>
    <context>
        <name>prontuario-dev</name>
        <desc>Escopo limitado ao path /prontuario-dev/ do ambiente bayarea.dataiesb.com</desc>
        <inscope>true</inscope>

        <!-- Inclui tudo dentro de /prontuario-dev (com ou sem trailing slash, qualquer path filho) -->
        <incregexes>https?://bayarea\.dataiesb\.com/[Pp]rontuario-[Dd]ev.*</incregexes>

        <tech>
            <include>Db.MongoDB</include>
            <include>Language.JavaScript</include>
            <include>OS.Linux</include>
            <include>WS.Nginx</include>
        </tech>

        <urlparser>
            <class>org.zaproxy.zap.model.StandardParameterParser</class>
            <config>{"kvps":"&amp;","kvs":"=","struct":[]}</config>
        </urlparser>

        <postparser>
            <class>org.zaproxy.zap.model.StandardParameterParser</class>
            <config>{"kvps":"&amp;","kvs":"=","struct":[]}</config>
        </postparser>
    </context>
</configuration>
